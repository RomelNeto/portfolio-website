# Cloudflare — headers
# (não usar Referrer-Policy: no-referrer aqui: o YouTube/Vimeo devolvem
#  o erro 153 quando o pedido chega sem referrer)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# sem versões nos nomes dos ficheiros, um max-age longo deixava o browser
# a mostrar JS e fotos antigos durante 1 dia depois de cada deploy.
# must-revalidate + ETag = 304 barato quando nada mudou, conteúdo novo quando muda.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
